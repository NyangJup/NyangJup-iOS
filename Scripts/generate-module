#!/bin/sh

set -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PACKAGE_PATH="$PROJECT_ROOT/NyangJup/Packages/Package"
SCRATCH_PATH="$PROJECT_ROOT/.build/module-generator"

swift run \
  --package-path "$PACKAGE_PATH" \
  --scratch-path "$SCRATCH_PATH" \
  ModuleGeneratorTool \
  --package-path "$PACKAGE_PATH" \
  "$@"
